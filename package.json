    "@vuepress/plugin-search": "2.0.0-rc.137",
    "@vuepress/theme-default": "2.0.0-rc.137",
    "@vuepress/utils": "2.0.0-rc.31",
    "chai": "6.2.2",
    "eslint": "10.11.0",
    "floating-vue": "5.4.0",
    "globals": "^17.4.0",
    "mocha": "^12.0.2",
    "node-red": "^5.0.7",
    "node-red-node-test-helper": "0.3.6",
    "prettier": "^3.8.1",
    "sass-embedded": "^1.105.0",
    "sass-loader": "^17.0.1",
    "sinon": "22.1.0",
    "vuepress": "2.0.0-rc.31"
  },
  "dependencies": {
    "luxon": "3.7.2"
  }
